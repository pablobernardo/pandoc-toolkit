{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "i18n message catalog",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
  },
  "additionalProperties": {
    "type": "string",
    "minLength": 1
  }
}
