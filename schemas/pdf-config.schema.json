{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandoc-toolkit.dev/schemas/pdf-config.schema.json",
  "title": "Pandoc PDF Toolkit Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "document",
    "input",
    "output",
    "pandoc",
    "filters",
    "runtime"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_dir"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "base_dir": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "publisher": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "rights": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "es", "pt", "gl"] },
        "titlepage": { "type": "boolean" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters_dir", "glob", "order", "explicit_files"],
      "properties": {
        "chapters_dir": { "type": "string", "minLength": 1 },
        "glob": { "type": "string", "minLength": 1 },
        "order": { "type": "string", "minLength": 1, "enum": ["natural", "alphabetical"] },
        "explicit_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "suffix", "keep_merged_markdown"],
      "properties": {
        "dir": { "type": "string", "minLength": 1 },
        "file_prefix": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string", "minLength": 1 },
        "formats": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "enum": ["pdf", "epub"] }
        },
        "keep_merged_markdown": { "type": "boolean" }
      }
    },
    "pandoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_engine",
        "toc",
        "toc_depth",
        "number_sections",
        "resource_path"
      ],
      "properties": {
        "pdf_engine": { "type": "string", "minLength": 1 },
        "toc": { "type": "boolean" },
        "toc_depth": { "type": "integer", "minimum": 1 },
        "number_sections": { "type": "boolean" },
        "template": { "type": "string", "minLength": 1 },
        "metadata_file": { "type": "string" },
        "resource_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emoji", "mermaid", "extra_lua_filters"],
      "properties": {
        "emoji": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "emoji_dir": { "type": "string", "minLength": 1 },
            "include_ballot_icons": { "type": "boolean" }
          }
        },
        "mermaid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "output_dir": { "type": "string", "minLength": 1 },
            "background": { "type": "string", "minLength": 1 }
          }
        },
        "extra_lua_filters": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_commands", "strict"],
      "properties": {
        "required_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "strict": { "type": "boolean" }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_clearpage_between_h1"],
      "properties": {
        "legacy_clearpage_between_h1": { "type": "boolean" }
      }
    }
  }
}
