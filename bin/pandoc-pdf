#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"

path_dirname() {
  local p="$1"
  if [[ "$p" == */* ]]; then
    printf '%s\n' "${p%/*}"
  else
    printf '.\n'
  fi
}

while [[ -h "$SOURCE_PATH" ]]; do
  LINK_DIR="$(cd -P -- "$(path_dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink -- "$SOURCE_PATH")"
  if [[ "$LINK_TARGET" != /* ]]; then
    SOURCE_PATH="$LINK_DIR/$LINK_TARGET"
  else
    SOURCE_PATH="$LINK_TARGET"
  fi
done

SCRIPT_DIR="$(cd -P -- "$(path_dirname "$SOURCE_PATH")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

usage() {
  cat <<'EOF'
Pandoc PDF Toolkit CLI

Usage:
  pandoc-pdf --version
  pandoc-pdf version
  pandoc-pdf info [--json]
  pandoc-pdf doctor [-c <pdf.config.yaml>]
  pandoc-pdf validate-config -c <pdf.config.yaml>
  pandoc-pdf render -c <pdf.config.yaml>

Notes:
  - render usa implementación nativa.
  - Config parsing supports Python+PyYAML o Ruby stdlib YAML.
EOF
}

CONFIG_PARSER=""

show_version() {
  local version_file="$ROOT_DIR/VERSION"
  if [[ -f "$version_file" ]]; then
    local version
    version="$(tr -d '[:space:]' < "$version_file")"
    if [[ -n "$version" ]]; then
      echo "pandoc-pdf ${version}"
      return 0
    fi
  fi
  echo "pandoc-pdf 0.0.0-dev"
}

get_version_value() {
  local version_file="$ROOT_DIR/VERSION"
  if [[ -f "$version_file" ]]; then
    local version
    version="$(tr -d '[:space:]' < "$version_file")"
    if [[ -n "$version" ]]; then
      echo "$version"
      return 0
    fi
  fi
  echo "0.0.0-dev"
}

detect_yaml_parser() {
  if python3 - <<'PY' >/dev/null 2>&1
import yaml  # noqa: F401
PY
  then
    echo "python"
    return 0
  fi

  if ruby -e 'require "yaml"' >/dev/null 2>&1; then
    echo "ruby"
    return 0
  fi

  echo "none"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"
  printf '%s' "$s"
}

show_info() {
  local output_format="${1:-text}"
  local version
  local yaml_parser
  local schema_path="$ROOT_DIR/schemas/pdf-config.schema.json"
  local defaults_path="$ROOT_DIR/defaults/default.yaml"
  local template_path="$ROOT_DIR/templates/default.tex"

  version="$(get_version_value)"
  yaml_parser="$(detect_yaml_parser)"

  local schema_exists=false
  local defaults_exists=false
  local template_exists=false
  [[ -f "$schema_path" ]] && schema_exists=true
  [[ -f "$defaults_path" ]] && defaults_exists=true
  [[ -f "$template_path" ]] && template_exists=true

  if [[ "$output_format" == "json" ]]; then
    printf '{\n'
    printf '  "name": "%s",\n' "pandoc-pdf"
    printf '  "version": "%s",\n' "$(json_escape "$version")"
    printf '  "root_dir": "%s",\n' "$(json_escape "$ROOT_DIR")"
    printf '  "yaml_parser": "%s",\n' "$(json_escape "$yaml_parser")"
    printf '  "schema_path": "%s",\n' "$(json_escape "$schema_path")"
    printf '  "schema_exists": %s,\n' "$schema_exists"
    printf '  "defaults_path": "%s",\n' "$(json_escape "$defaults_path")"
    printf '  "defaults_exists": %s,\n' "$defaults_exists"
    printf '  "template_path": "%s",\n' "$(json_escape "$template_path")"
    printf '  "template_exists": %s\n' "$template_exists"
    printf '}\n'
    return 0
  fi

  echo "pandoc-pdf ${version}"
  echo "root_dir: ${ROOT_DIR}"
  echo "yaml_parser: ${yaml_parser}"
  echo "schema_path: ${schema_path} (exists=${schema_exists})"
  echo "defaults_path: ${defaults_path} (exists=${defaults_exists})"
  echo "template_path: ${template_path} (exists=${template_exists})"
}

ensure_config_parser() {
  if [[ -n "${CONFIG_PARSER}" ]]; then
    return 0
  fi

  if python3 - <<'PY' >/dev/null 2>&1
import yaml  # noqa: F401
PY
  then
    CONFIG_PARSER="python"
    return 0
  fi

  if ruby -e 'require "yaml"' >/dev/null 2>&1; then
    CONFIG_PARSER="ruby"
    return 0
  fi

  echo "❌ No hay parser YAML disponible"
  echo "   Opción 1: python3 -m pip install pyyaml"
  echo "   Opción 2: instalar Ruby con stdlib YAML"
  exit 1
}

run_doctor() {
  local config_path="${1:-}"
  local preflight_script="$ROOT_DIR/scripts/preflight.sh"
  if [[ ! -x "$preflight_script" ]]; then
    echo "❌ No se encontró preflight ejecutable: $preflight_script"
    exit 1
  fi
  if [[ -n "$config_path" ]]; then
    /bin/bash "$preflight_script" -c "$config_path"
  else
    /bin/bash "$preflight_script"
  fi
}

validate_config_file() {
  local config_path="$1"
  python3 "$ROOT_DIR/scripts/validate-config.py" "$config_path" "$ROOT_DIR/schemas/pdf-config.schema.json"
}

run_render() {
  local config_path="$1"
  ensure_config_parser

  if [[ "${CONFIG_PARSER}" == "python" ]]; then
    python3 "$ROOT_DIR/scripts/render-native.py" "$config_path" "$ROOT_DIR"
    return 0
  fi

  ruby "$ROOT_DIR/scripts/render-native.rb" "$config_path" "$ROOT_DIR"
}

main() {
  local command="${1:-}"
  if [[ -z "$command" ]]; then
    usage
    exit 1
  fi
  shift || true

  case "$command" in
    version|--version|-V)
      show_version
      ;;
    info)
      local output_format="text"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            output_format="json"
            shift
            ;;
          *)
            echo "❌ Argumento no reconocido: $1"
            usage
            exit 1
            ;;
        esac
      done
      show_info "$output_format"
      ;;
    doctor)
      local config=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -c|--config)
            config="$2"
            shift 2
            ;;
          *)
            echo "❌ Argumento no reconocido: $1"
            usage
            exit 1
            ;;
        esac
      done
      run_doctor "$config"
      ;;
    validate-config)
      local config=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -c|--config)
            config="$2"
            shift 2
            ;;
          *)
            echo "❌ Argumento no reconocido: $1"
            usage
            exit 1
            ;;
        esac
      done

      if [[ -z "$config" ]]; then
        echo "❌ Debes indicar -c <pdf.config.yaml>"
        exit 1
      fi
      validate_config_file "$config"
      ;;
    render)
      local config=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -c|--config)
            config="$2"
            shift 2
            ;;
          *)
            echo "❌ Argumento no reconocido: $1"
            usage
            exit 1
            ;;
        esac
      done

      if [[ -z "$config" ]]; then
        echo "❌ Debes indicar -c <pdf.config.yaml>"
        exit 1
      fi

      validate_config_file "$config"
      run_render "$config"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "❌ Comando desconocido: ${command}"
      usage
      exit 1
      ;;
  esac
}

main "$@"
